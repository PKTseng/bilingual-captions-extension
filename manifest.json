{
  "manifest_version": 3,
  "name": "雙語字幕",
  "version": "0.7.0",
  "description": "使用 Chrome 內建翻譯，在 YouTube 顯示英文和繁體中文雙字幕。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "captions.js",
        "subtitle-parser.js",
        "transcript.js",
        "page-bridge.js",
        "content.js"
      ],
      "css": [
        "subtitles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
