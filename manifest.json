{
  "manifest_version": 3,
  "name": "雙語字幕",
  "version": "0.8.0",
  "description": "在 YouTube 顯示原文（英文、日文、韓文、泰文）和繁體中文雙字幕，可選 Chrome 內建翻譯或 AI 翻譯。",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "雙語字幕",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "languages.js",
        "captions.js",
        "subtitle-parser.js",
        "transcript.js",
        "page-bridge.js",
        "settings.js",
        "seven-knights-glossary.js",
        "ai-translator.js",
        "translation-store.js",
        "content.js"
      ],
      "css": [
        "subtitles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
